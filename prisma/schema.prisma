generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StatusScan {
  PENDENTE
  CONCLUIDO
  ERRO
}

enum UserRole {
  ADMIN
  MEMBRO
}

enum AiProvider {
  GEMINI
  OPENAI
  ANTHROPIC
  GROQ
}

model AiSettings {
  id        String     @id @default("singleton")
  provider  AiProvider @default(GEMINI)
  apiKey    String     @map("api_key")
  model     String
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("ai_settings")
}

model User {
  id        String              @id @default(cuid())
  nome      String
  email     String              @unique
  senhaHash String              @map("senha_hash")
  role      UserRole            @default(MEMBRO)
  criadoEm  DateTime            @default(now()) @map("criado_em")
  sessions  Session[]
  geracoes  GeracaoDeConteudo[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  criadoEm  DateTime @default(now()) @map("criado_em")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Site {
  id                 String              @id @default(cuid())
  nome               String
  url                String
  nicho              String              @default("")
  publicoAlvo        String              @default("") @map("publico_alvo")
  tomDeVoz           String              @default("") @map("tom_de_voz")
  palavrasChaveBase  String[]            @default([]) @map("palavras_chave_base")
  notasDeEstilo      String              @default("") @map("notas_de_estilo")
  statusScan         StatusScan          @default(PENDENTE) @map("status_scan")
  ultimoScanEm       DateTime?           @map("ultimo_scan_em")
  criadoEm           DateTime            @default(now()) @map("criado_em")
  atualizadoEm       DateTime            @updatedAt @map("atualizado_em")
  geracoes           GeracaoDeConteudo[]

  @@index([statusScan])
  @@map("sites")
}

model GeracaoDeConteudo {
  id                    String   @id @default(cuid())
  siteId                String   @map("site_id")
  userId                String?  @map("user_id")
  textoOriginal         String   @map("texto_original") @db.Text
  textoOtimizado        String   @map("texto_otimizado") @db.Text
  metaTitle             String   @map("meta_title")
  metaDescription       String   @map("meta_description") @db.Text
  palavrasChaveUsadas   String[] @default([]) @map("palavras_chave_usadas")
  palavrasChaveSugeridas String[] @default([]) @map("palavras_chave_sugeridas")
  altTexts              String[] @default([]) @map("alt_texts")
  criadoEm              DateTime @default(now()) @map("criado_em")
  site                  Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([siteId, criadoEm])
  @@map("geracoes_de_conteudo")
}
